# Online Magazin — placeholders only. Never commit real values. (TAQVIM secrets must not be reused.)
NODE_ENV=development
OM_DB_PASSWORD=change-me-local-only
PUBLIC_WEB_URL=http://localhost:3000
# Production domain (without https://), used by Caddy for automatic TLS
OM_DOMAIN=
# Staging (site behind password, demo data allowed): OM_CADDYFILE=Caddyfile.staging, OM_NODE_ENV=development,
# OM_STAGE_USER=owner, OM_STAGE_HASH='<output of: docker run --rm caddy:2.8.4 caddy hash-password --plaintext YOUR-PASSWORD>'
# IMPORTANT: keep the hash in SINGLE quotes — it contains $ characters that Compose would otherwise interpolate.
OM_CADDYFILE=Caddyfile
OM_NODE_ENV=production
OM_STAGE_USER=owner
OM_STAGE_HASH=
SESSION_TTL_HOURS=720
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_HOURLY_LIMIT=5
# OTP_DEV_ECHO is ignored in production
RESERVATION_TTL_MINUTES=15
# Required in production (>=32 random chars); encrypts TOTP secrets. Generate: openssl rand -base64 48
MFA_ENC_KEY=
STEP_UP_MINUTES=10
MEDIA_DIR=/data/media
# AI assist (feature flag in DB, off by default)
AI_DAILY_REQUEST_CAP=2000
QUOTE_TTL_MINUTES=15
# Payments: disabled | sandbox | live. Live requires merchant contract + keys (externally blocked).
PAYME_MODE=sandbox
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.test.paycom.uz
CLICK_MODE=sandbox
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# SMS / Telegram: not configured (dev log adapter only). Separate Online Magazin bot required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Eskiz.uz SMS for login codes (set by scripts/server/sms-setup.sh). SMS_OTP_TEXT must equal the Eskiz-approved text, {code} = the code
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_OTP_TEXT=
# Database name: online_magazin = DEMO, uzshop_live = real shop (set by scripts/server/go-live.sh)
OM_DB_NAME=online_magazin
# Android app push (Firebase service account JSON, base64; set by scripts/server/push-setup.sh)
FCM_SERVICE_ACCOUNT_B64=
# Telegram Mini App bots (one bot each; set by scripts/server/telegram-app-setup.sh partner|operator)
TELEGRAM_PARTNER_BOT_TOKEN=
TELEGRAM_PARTNER_BOT_USERNAME=
TELEGRAM_PARTNER_BOT_WEBHOOK_SECRET=
TELEGRAM_OPERATOR_BOT_TOKEN=
TELEGRAM_OPERATOR_BOT_USERNAME=
TELEGRAM_OPERATOR_BOT_WEBHOOK_SECRET=
# Mini app login data older than this is refused (seconds, default 1 day)
TG_WEBAPP_MAX_AGE_SECONDS=86400

# Partner/customer support Telegram (@username or https://t.me/...) — shown as 'Qo‘llab-quvvatlash'
SUPPORT_TELEGRAM=
