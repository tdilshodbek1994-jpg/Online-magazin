{
  "schema_version": "1.0",
  "synthetic": false,
  "status": "design_contract_not_connected_to_database",
  "money_encoding": "decimal string with currency or integer minor units; never float for authoritative money",
  "metrics": [
    {
      "key": "orders_created",
      "label_cyrl": "Яратилган буюртмалар",
      "unit": "orders",
      "formula": "COUNT(DISTINCT accepted_internal_order_id); exclude synthetic/deleted-test records",
      "grain": "order",
      "date_basis": "created_at",
      "source_service": "orders",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "orders_accepted_event",
      "label_cyrl": "Даврда тасдиқланган буюртмалар",
      "unit": "orders",
      "formula": "COUNT(DISTINCT order_id with valid accepted event in period); reopened cycles not counted twice unless explicit metric",
      "grain": "order",
      "date_basis": "accepted_event_at",
      "source_service": "order_events",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "orders_rejected_event",
      "label_cyrl": "Даврда рад этилган буюртмалар",
      "unit": "orders",
      "formula": "COUNT(DISTINCT order_id with unretracted customer-rejected event in period); not returns or no-answer",
      "grain": "order",
      "date_basis": "rejected_event_at",
      "source_service": "order_events",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "orders_cancelled_event",
      "label_cyrl": "Бекор қилинган буюртмалар",
      "unit": "orders",
      "formula": "COUNT(DISTINCT order_id with valid cancel event in period); expose reason classification",
      "grain": "order",
      "date_basis": "cancel_event_at",
      "source_service": "order_events",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "orders_delivered",
      "label_cyrl": "Етказилган буюртмалар",
      "unit": "orders",
      "formula": "COUNT(DISTINCT order_id meeting published full-delivery policy); partial delivery separately labelled",
      "grain": "order",
      "date_basis": "delivered_event_at",
      "source_service": "fulfillment",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "units_delivered_net",
      "label_cyrl": "Етказилган соф доналар",
      "unit": "units",
      "formula": "Eligible delivered units minus valid returned units under selected cohort/event basis; no mixing date bases",
      "grain": "order_line_unit",
      "date_basis": "explicit_delivery_cohort_or_movement_period",
      "source_service": "fulfillment_returns",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "units_returned",
      "label_cyrl": "Қайтарилган доналар",
      "unit": "units",
      "formula": "SUM(valid returned unit quantity); exclude duplicate/retracted events",
      "grain": "return_line",
      "date_basis": "return_accepted_at",
      "source_service": "returns",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "cohort_acceptance_rate",
      "label_cyrl": "Тасдиқлаш улуши",
      "unit": "percent",
      "formula": "accepted_orders_in_cohort / all_valid_created_orders_in_same_cohort * 100; show unresolved count",
      "grain": "order_cohort",
      "date_basis": "created_at cohort, status as_of",
      "source_service": "order_events",
      "kind": "ratio",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "finalized_delivery_rate",
      "label_cyrl": "Натижаси маълум буюртмалардан етказиш",
      "unit": "percent",
      "formula": "delivered / accepted_orders_with_final_outcome * 100; pending excluded and shown",
      "grain": "accepted_order_cohort",
      "date_basis": "accepted_at cohort, terminal outcome as_of",
      "source_service": "fulfillment",
      "kind": "ratio",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "commission_recognized_net",
      "label_cyrl": "Тан олинган соф комиссия",
      "unit": "UZS",
      "formula": "SUM(signed recognized commission ledger movements); reversals included exactly once",
      "grain": "commission_ledger_entry",
      "date_basis": "recognized_at",
      "source_service": "commission_ledger",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "commission_pending",
      "label_cyrl": "Кутилаётган комиссия",
      "unit": "UZS",
      "formula": "Authoritative pending balance at as_of; not summed across snapshots",
      "grain": "partner_balance",
      "date_basis": "as_of",
      "source_service": "commission_ledger",
      "kind": "stock",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "wallet_available",
      "label_cyrl": "Ечиш мумкин бўлган маблағ",
      "unit": "UZS",
      "formula": "Authoritative spendable cash wallet balance; held/pending excluded",
      "grain": "partner_wallet",
      "date_basis": "as_of",
      "source_service": "wallet",
      "kind": "stock",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "payout_paid",
      "label_cyrl": "Ҳақиқатан тўланган маблағ",
      "unit": "UZS",
      "formula": "SUM(confirmed successful payout amounts); no counting requests as paid",
      "grain": "payout",
      "date_basis": "paid_at",
      "source_service": "payout",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "cash_collected",
      "label_cyrl": "Олинган пул",
      "unit": "UZS",
      "formula": "SUM(confirmed collections net applicable collection reversals); state tender/provider",
      "grain": "payment_movement",
      "date_basis": "collected_at",
      "source_service": "payments_cod",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "cash_remitted",
      "label_cyrl": "Магазинга топширилган COD",
      "unit": "UZS",
      "formula": "SUM(reconciled remittance movements); not new sales revenue",
      "grain": "cod_remittance",
      "date_basis": "remitted_at",
      "source_service": "cod_reconciliation",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "revenue_recognized_net",
      "label_cyrl": "Ҳисоб сиёсатидаги соф тушум",
      "unit": "UZS",
      "formula": "Existing finance revenue recognition service net returns; tax/shipping inclusion explicitly disclosed",
      "grain": "finance_entry",
      "date_basis": "recognized_at",
      "source_service": "finance_policy",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "cogs_recognized",
      "label_cyrl": "Ҳисобланган товар таннархи",
      "unit": "UZS",
      "formula": "SUM(recognized cost movements with order-time SKU cost snapshots); null if required costs missing",
      "grain": "inventory_cost_entry",
      "date_basis": "recognized_at",
      "source_service": "inventory_finance",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "ad_spend_allocated",
      "label_cyrl": "Тегишли реклама харажати",
      "unit": "UZS",
      "formula": "SUM(unique expense allocations for allowed payer/scope; amount uses historical FX snapshot)",
      "grain": "expense_allocation",
      "date_basis": "service_period",
      "source_service": "advertising_expenses",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "partner_after_ad_result",
      "label_cyrl": "Рекламадан кейинги натижа",
      "unit": "UZS",
      "formula": "commission_recognized_net - partner_paid_allocated_ad_spend - known_other_partner_costs; missing costs => partial/not_final",
      "grain": "partner_period",
      "date_basis": "aligned ledger/service period",
      "source_service": "partner_analytics",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "reward_expense_recognized",
      "label_cyrl": "Мукофот дастури харажати",
      "unit": "UZS",
      "formula": "Existing finance policy expense movements; liability settlement not duplicate expense",
      "grain": "reward_finance_entry",
      "date_basis": "recognized_at",
      "source_service": "rewards_finance",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "charity_donated",
      "label_cyrl": "Хайрияга ажратилган маблағ",
      "unit": "UZS",
      "formula": "SUM(valid consent-linked donation debits net reversals); transfer is different metric",
      "grain": "donation_entry",
      "date_basis": "donated_at",
      "source_service": "charity_ledger",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "charity_transferred",
      "label_cyrl": "Қабул қилувчига ўтказилган хайрия",
      "unit": "UZS",
      "formula": "SUM(confirmed transfers); no automatic inference from donations",
      "grain": "charity_transfer",
      "date_basis": "transferred_at",
      "source_service": "charity_ledger",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "uzcoin_available",
      "label_cyrl": "Мавжуд UzCoin",
      "unit": "UZC",
      "formula": "Authoritative available coin balance; not cash commission",
      "grain": "partner_coin_wallet",
      "date_basis": "as_of",
      "source_service": "uzcoin_ledger",
      "kind": "stock",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "uzcoin_pending",
      "label_cyrl": "Кутилаётган UzCoin",
      "unit": "UZC",
      "formula": "Authoritative pending coin balance",
      "grain": "partner_coin_wallet",
      "date_basis": "as_of",
      "source_service": "uzcoin_ledger",
      "kind": "stock",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "uzcoin_cash_equivalent",
      "label_cyrl": "UzCoin пул эквиваленти",
      "unit": "UZS",
      "formula": "Available eligible coins valued by applicable rate policy/snapshot; not a payout or gift retail value",
      "grain": "coin_rate_lot",
      "date_basis": "as_of with rate version",
      "source_service": "uzcoin_conversion",
      "kind": "stock",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "operator_no_answer_attempts",
      "label_cyrl": "Жавобсиз алоқа уринишлари",
      "unit": "attempts",
      "formula": "COUNT(valid contact attempts classified no_answer); recorded provenance, not invented call evidence",
      "grain": "contact_attempt",
      "date_basis": "attempted_at",
      "source_service": "operator_calls",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "overdue_callback_count",
      "label_cyrl": "Кечиккан қайта қўнғироқлар",
      "unit": "tasks",
      "formula": "COUNT(open callbacks due before as_of under current assignment permissions)",
      "grain": "callback_task",
      "date_basis": "as_of",
      "source_service": "operator_queue",
      "kind": "stock",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "cohort_link_conversion",
      "label_cyrl": "Ҳавола конверсияси",
      "unit": "percent",
      "formula": "eligible web orders attributed to same traffic cohort / eligible sessions *100; manual orders not inserted without web evidence",
      "grain": "session_cohort",
      "date_basis": "traffic cohort as_of",
      "source_service": "traffic_analytics",
      "kind": "ratio",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "contest_rank",
      "label_cyrl": "Конкурсдаги ўрин",
      "unit": "rank",
      "formula": "Contest engine result for rules revision and eligibility; provisional/final distinguished",
      "grain": "contest_participant",
      "date_basis": "contest period and ranking as_of",
      "source_service": "contests",
      "kind": "rank",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "store_result_provisional",
      "label_cyrl": "Магазиннинг ҳисобланган натижаси",
      "unit": "UZS",
      "formula": "Finance service: revenue - cogs - commission expense - ads - fulfillment/provider/other recognized costs; coins/charity classified by finance policy; missing costs => incomplete",
      "grain": "finance_period",
      "date_basis": "recognized_at aligned period",
      "source_service": "finance_policy",
      "kind": "flow",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "best_earning_day",
      "label_cyrl": "Энг даромадли кун",
      "unit": "date_and_UZS",
      "formula": "MAX of daily scoped commission_recognized_net for specified year; return all ties or explicit stable paging",
      "grain": "partner_local_day",
      "date_basis": "business_timezone local date",
      "source_service": "commission_analytics",
      "kind": "rank",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    },
    {
      "key": "period_growth",
      "label_cyrl": "Даврлар орасидаги ўзгариш",
      "unit": "percent_or_null",
      "formula": "(current-previous)/previous*100 only when previous>0 and compatible complete coverage; otherwise labelled absolute change",
      "grain": "metric_period_pair",
      "date_basis": "matched comparable periods",
      "source_service": "analytics_comparison",
      "kind": "ratio",
      "missing_policy": "unknown_not_zero",
      "version": 1,
      "scope": "server_authorized_rows_and_columns",
      "status": "contract_proposal_map_to_existing_services"
    }
  ]
}
